# Safe to expose to the browser. Find both values in Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only random value used to hash contact-submission IP addresses.
CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-value

# Server-only email delivery. Create a sending API key in Resend.
RESEND_API_KEY=
# One bare email address on a domain verified in Resend (no display name).
CONTACT_FROM_EMAIL=
# Your inbox, where portfolio contact messages should arrive.
CONTACT_TO_EMAIL=

# Site URL for Supabase auth redirects (set to your production URL on Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth provider configuration (set in Supabase Dashboard, not here) ───────
# Google OAuth: Dashboard → Authentication → Providers → Google
#   Provide GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from Google Cloud Console.
# Phone (SMS) OTP: Dashboard → Authentication → Providers → Phone
#   Provide TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER.
